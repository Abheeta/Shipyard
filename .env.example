# Copy to .env and adjust. Every value has a working default for localhost.

# ---- Runtime ----
SHIPYARD_ENV=local                     # local | production
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins allowed to call the API. "*" for wide-open local dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Data locations (relative to backend/ or absolute) ----
RAW_SAVED_PATH=../saved_posts.json
RAW_LIKED_PATH=../liked_posts (1).json
INDEX_DIR=data/index
DATABASE_PATH=data/state.sqlite

# ---- Embeddings ----
EMBED_BACKEND=tfidf                     # tfidf | fastembed | sentence-transformers
EMBED_MODEL=BAAI/bge-small-en-v1.5      # used by fastembed / sentence-transformers only
EMBED_BATCH=256
TFIDF_COMPONENTS=200
TFIDF_MAX_FEATURES=20000

# ---- Clustering ----
CLUSTER_METHOD=kmeans                   # kmeans | hdbscan
HDBSCAN_MIN_CLUSTER_SIZE=18
KMEANS_K=0                              # 0 = auto-pick via silhouette sweep
KMEANS_K_MIN=15
KMEANS_K_MAX=45

# ---- LLM (enrichment + Q&A) ----
LLM_PROVIDER=none                       # none | anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5               # used for both enrichment and Q&A
LLM_ENRICH_MODEL=                       # optional override for the bulk pass
LLM_MAX_ENRICH_ITEMS=0                  # 0 = all; set a cap to bound cost

# ---- Frontend (build-time; see frontend/.env) ----
# VITE_API_BASE_URL=http://127.0.0.1:8000
